{
  "$schema": "../../block-manifest.schema.json",
  "manifest": 1,
  "id": "chadfx.color",
  "version": "1.0.0",
  "format": 1,
  "name": "Color",
  "description": "Exposure, contrast, saturation, temperature, tint and lift, gamma and gain. All colour blocks of a stack combine into one: exposure, temperature, tint and lift add up; contrast, saturation, gamma and gain multiply.",
  "category": "color",
  "kind": "video.filter",
  "fold": "params",
  "params": [
    {
      "id": "exposure",
      "type": "float",
      "default": 0.0,
      "min": -10.0,
      "max": 10.0,
      "step": 0.01,
      "unit": "stops",
      "label": "Exposure",
      "description": "Exposure in stops.",
      "fold": "add"
    },
    {
      "id": "contrast",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.01,
      "unit": "multiplier",
      "label": "Contrast",
      "description": "Contrast multiplier around middle grey.",
      "fold": "multiply"
    },
    {
      "id": "saturation",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.01,
      "unit": "multiplier",
      "label": "Saturation",
      "description": "Saturation multiplier.",
      "fold": "multiply"
    },
    {
      "id": "temperature",
      "type": "float",
      "default": 0.0,
      "min": -100.0,
      "max": 100.0,
      "step": 1.0,
      "unit": "none",
      "label": "Temperature",
      "description": "Warm (+) or cool (-) shift.",
      "fold": "add"
    },
    {
      "id": "tint",
      "type": "float",
      "default": 0.0,
      "min": -100.0,
      "max": 100.0,
      "step": 1.0,
      "unit": "none",
      "label": "Tint",
      "description": "Magenta (+) or green (-) shift.",
      "fold": "add"
    },
    {
      "id": "lift",
      "type": "vec3",
      "default": [0.0, 0.0, 0.0],
      "min": -1.0,
      "max": 1.0,
      "step": 0.01,
      "unit": "none",
      "label": "Lift",
      "description": "Shadows offset per channel.",
      "advanced": true,
      "fold": "add",
      "components": ["R", "G", "B"]
    },
    {
      "id": "gamma",
      "type": "vec3",
      "default": [1.0, 1.0, 1.0],
      "min": 0.1,
      "max": 4.0,
      "step": 0.01,
      "unit": "none",
      "label": "Gamma",
      "description": "Midtones per channel.",
      "advanced": true,
      "fold": "multiply",
      "components": ["R", "G", "B"]
    },
    {
      "id": "gain",
      "type": "vec3",
      "default": [1.0, 1.0, 1.0],
      "min": 0.0,
      "max": 4.0,
      "step": 0.01,
      "unit": "multiplier",
      "label": "Gain",
      "description": "Highlights multiplier per channel.",
      "advanced": true,
      "fold": "multiply",
      "components": ["R", "G", "B"]
    }
  ],
  "video": {
    "source": "block.wgsl",
    "stages": ["pixel"]
  }
}
