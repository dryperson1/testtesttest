{
  "$schema": "../../block-manifest.schema.json",
  "manifest": 1,
  "id": "chadfx.blur",
  "version": "1.0.0",
  "format": 1,
  "name": "Blur",
  "description": "Gaussian blur of the layer. The radius is in sequence pixels, so the blur looks the same in a reduced preview and in the export.",
  "category": "blur",
  "kind": "video.filter",
  "params": [
    {
      "id": "radius",
      "type": "float",
      "default": 8.0,
      "min": 0.0,
      "max": 200.0,
      "step": 0.5,
      "unit": "px",
      "label": "Radius",
      "description": "How far the blur spreads, in sequence pixels."
    }
  ],
  "video": {
    "source": "block.wgsl",
    "stages": [],
    "passes": [
      { "name": "blur_h", "input": "layer", "output": "a" },
      { "name": "blur_v", "input": "a", "output": "b" },
      { "name": "wide_h", "input": "b", "output": "c" },
      { "name": "wide_v", "input": "c", "output": "result" }
    ]
  }
}
