{
  "$schema": "../../block-manifest.schema.json",
  "manifest": 1,
  "id": "chadfx.eq3",
  "version": "1.0.0",
  "format": 1,
  "name": "EQ",
  "description": "Three-band equalizer: a low shelf, a peak in the middle and a high shelf. The peak sits halfway between the two corner frequencies on a musical (logarithmic) scale. With all three gains at 0 dB the sound is unchanged.",
  "category": "equalizer",
  "kind": "audio.filter",
  "params": [
    {
      "id": "low_gain_db",
      "type": "float",
      "default": 0.0,
      "min": -24.0,
      "max": 24.0,
      "step": 0.1,
      "unit": "db",
      "label": "Low gain",
      "description": "Low shelf gain in dB."
    },
    {
      "id": "mid_gain_db",
      "type": "float",
      "default": 0.0,
      "min": -24.0,
      "max": 24.0,
      "step": 0.1,
      "unit": "db",
      "label": "Mid gain",
      "description": "Mid band gain in dB."
    },
    {
      "id": "high_gain_db",
      "type": "float",
      "default": 0.0,
      "min": -24.0,
      "max": 24.0,
      "step": 0.1,
      "unit": "db",
      "label": "High gain",
      "description": "High shelf gain in dB."
    },
    {
      "id": "low_freq",
      "type": "float",
      "default": 200.0,
      "min": 20.0,
      "max": 20000.0,
      "step": 1.0,
      "unit": "hz",
      "label": "Low frequency",
      "description": "Low shelf corner in Hz."
    },
    {
      "id": "high_freq",
      "type": "float",
      "default": 4000.0,
      "min": 20.0,
      "max": 20000.0,
      "step": 1.0,
      "unit": "hz",
      "label": "High frequency",
      "description": "High shelf corner in Hz."
    }
  ],
  "audio": {
    "module": "block.wasm",
    "warmup_ms": 200,
    "latency_samples": 0,
    "tail_ms": 200
  }
}
